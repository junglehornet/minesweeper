package main;

import "io";
import "os";
import "time";

struct Game {
    width, height, mines, cursor, seconds int;
    seeded, lost, won bool;
    cells []int; // -1 = mine, otherwise adjacent count
    visible []int; // 0 = hidden, 1 = revealed, 2 = flag
    random int;
    boardID string;
}
func newGame(level int) Game {
    g := Game{boardID:io.Sprint(time.Monotonic()),width:9, height:9, mines:10, random:time.Monotonic() % 2147483646 + 1};
    if (level == 1) { g.width = 16; g.height = 16; g.mines = 40; }
    if (level == 2) { g.width = 30; g.height = 16; g.mines = 99; }
    for (i := 0; i < g.width*g.height; i++) { g.cells.append(0); g.visible.append(0); }
    return g;
}
func (g *Game) neighbors(index int) []int {
    result := []int{};
    x := index % g.width; y := index / g.width;
    for (dy := -1; dy <= 1; dy++) for (dx := -1; dx <= 1; dx++) {
        xx := x+dx; yy := y+dy;
        if ((dx != 0 || dy != 0) && xx >= 0 && xx < g.width && yy >= 0 && yy < g.height) result.append(yy*g.width+xx);
    }
    return result;
}
func (g *Game) seed(first int) {
    placed := 0;
    for (placed < g.mines) {
        g.random = g.random * 48271 % 2147483647;
        i := g.random % len(g.cells);
        dx := i%g.width-first%g.width; dy := i/g.width-first/g.width;
        if (g.cells[i] == -1 || (dx >= -1 && dx <= 1 && dy >= -1 && dy <= 1)) continue;
        g.cells[i] = -1; placed++;
    }
    for (i := 0; i < len(g.cells); i++) {
        if (g.cells[i] == -1) continue;
        for (_, n := range g.neighbors(i)) if (g.cells[n] == -1) g.cells[i]++;
    }
    g.seeded = true;
}
func (g *Game) reveal(index int) {
    if (g.lost || g.won || g.visible[index] == 2) return;
    if (!g.seeded) g.seed(index);
    if (g.visible[index] == 1) { g.chord(index); return; }
    queue := []int{index};
    for (head := 0; head < len(queue); head++) {
        i := queue[head];
        if (g.visible[i] == 1 || g.visible[i] == 2) continue;
        g.visible[i] = 1;
        if (g.cells[i] == -1) { g.lost = true; return; }
        if (g.cells[i] == 0) for (_, n := range g.neighbors(i)) if (g.visible[n] == 0) { g.visible[n] = 3; queue.append(n); }

    }
    safe := 0;
    for (_, state := range g.visible) if (state == 1) safe++;
    g.won = safe == len(g.cells)-g.mines;
}
func (g *Game) chord(index int) {
    if (g.cells[index] <= 0 || g.lost || g.won) return;
    flags := 0;
    for (_, n := range g.neighbors(index)) if (g.visible[n] == 2) flags++;
    if (flags == g.cells[index]) for (_, n := range g.neighbors(index)) if (g.visible[n] == 0) g.reveal(n);
}
func (g *Game) flag(index int) {
    if (g.lost || g.won || g.visible[index] == 1) return;
    g.visible[index] = g.visible[index] == 2 ? 0 : 2;
}
func (g *Game) flags() int {
    count := 0;
    for (_, state := range g.visible) if (state == 2) count++;
    return count;
}
func (g *Game) encode() string {
    text := "OCEAN_MINES_1\n";
    for (_, v := range []int{g.width,g.height,g.mines,g.cursor,g.seconds,g.seeded ? 1 : 0}) text += io.Sprint(v)+"\n";
    for (i := 0; i < len(g.cells); i++) text += io.Sprint(g.cells[i])+"\n"+io.Sprint(g.visible[i])+"\n";
    text += "BOARD_ID\n"+g.boardID+"\n";
    return text;
}
func saveGame(g *Game) Result<bool> { return saveGameTo(g, "minesweeper.save"); }
func saveGameTo(g *Game, path string) Result<bool> {
    file := os.Open(path, os.FileMode.Write);
    if (file == Result<os.File>.error) return Result<bool>.error(file.(Result<os.File>.error));
    f := file.unwrap(); defer f.Close();
    result := f.Write(g.encode());
    if (result == Result<int>.error) return Result<bool>.error(result.(Result<int>.error));
    return Result<bool>.value(true);
}
func loadGame() Result<Game> { return loadGameFrom("minesweeper.save"); }
func loadGameFrom(path string) Result<Game> {
    opened := os.Open(path, os.FileMode.Read);
    if (opened == Result<os.File>.error) return Result<Game>.error("No saved game found.");
    f := opened.unwrap(); defer f.Close();
    size := f.Size();
    if (size == Result<int>.error) return Result<Game>.error("Cannot read save.");
    if (size.unwrap() > 20000) return Result<Game>.error("Invalid save file.");
    scanner := io.NewScanner(f);
    header := scanner.Scanln();
    if (header == Result<string>.error) return Result<Game>.error("Cannot read save.");
    if (header.unwrap() != "OCEAN_MINES_1") return Result<Game>.error("Invalid save format.");
    values := []int{};
    for (i := 0; i < 6; i++) {
        line := scanner.Scanln();
        if (line == Result<string>.error) return Result<Game>.error("Incomplete save.");
        number := io.ParseInt(line.unwrap());
        if (number == Result<int>.error) return Result<Game>.error("Invalid save number.");
        values.append(number.unwrap());
    }
    w := values[0]; h := values[1]; m := values[2];
    if (!((w == 9 && h == 9 && m == 10) || (w == 16 && h == 16 && m == 40) || (w == 30 && h == 16 && m == 99))) return Result<Game>.error("Invalid saved difficulty.");
    if (values[3] < 0 || values[3] >= w*h || values[4] < 0 || values[4] > 100000000 || values[5] < 0 || values[5] > 1) return Result<Game>.error("Invalid save metadata.");
    g := Game{width:w,height:h,mines:m,cursor:values[3],seconds:values[4],seeded:values[5] == 1,random:time.Monotonic()%2147483646+1};
    for (i := 0; i < w*h; i++) for (part := 0; part < 2; part++) {
        line := scanner.Scanln();
        if (line == Result<string>.error) return Result<Game>.error("Incomplete save.");
        n := io.ParseInt(line.unwrap());
        if (n == Result<int>.error) return Result<Game>.error("Invalid cell.");
        v := n.unwrap();
        if (part == 0) { if (v < -1 || v > 8) return Result<Game>.error("Invalid cell."); g.cells.append(v); }
        else { if (v < 0 || v > 2) return Result<Game>.error("Invalid cell state."); g.visible.append(v); }
    }
    marker := scanner.Scanln();
    if (marker == Result<string>.error) return Result<Game>.error("Cannot read board identity.");
    if (marker.unwrap() != "") {
        if (marker.unwrap() != "BOARD_ID") return Result<Game>.error("Invalid board identity.");
        identity := scanner.Scanln();
        if (identity == Result<string>.error) return Result<Game>.error("Incomplete board identity.");
        g.boardID = identity.unwrap();
    }
    count := 0; revealed := 0;
    for (i := 0; i < w*h; i++) {
        if (g.cells[i] == -1) { count++; if (g.visible[i] == 1) return Result<Game>.error("Save contains a finished game."); }
        else {
            adjacent := 0;
            for (_, n := range g.neighbors(i)) if (g.cells[n] == -1) adjacent++;
            if (g.cells[i] != adjacent) return Result<Game>.error("Inconsistent saved board.");
        }
        if (g.visible[i] == 1) revealed++;
    }
    if ((g.seeded && count != m) || (!g.seeded && (count != 0 || revealed != 0)) || revealed == w*h-m) return Result<Game>.error("Invalid saved board.");
    return Result<Game>.value(g);
}

// Legacy saves have no ID; compare their immutable board layout instead.
func sameBoard(first *Game, second *Game) bool {
    if (first.boardID != "" && second.boardID != "") return first.boardID == second.boardID;
    if (first.width != second.width || first.height != second.height || first.mines != second.mines || first.seeded != second.seeded) return false;
    for (i := 0; i < len(first.cells); i++) if (first.cells[i] != second.cells[i]) return false;
    return true;
}
func differentSavedBoard(g *Game) bool { return differentBoardAt(g, "minesweeper.save"); }
func differentBoardAt(g *Game, path string) bool {
    opened := os.Open(path, os.FileMode.Read);
    if (opened == Result<os.File>.error) return false;
    opened.unwrap().Close();
    saved := loadGameFrom(path);
    // Protect existing files even if their contents cannot be loaded.
    if (saved == Result<Game>.error) return true;
    other := saved.unwrap();
    return !sameBoard(g, &other);
}
