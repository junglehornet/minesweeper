package main;

import "os";
import "term/tui";

extern *void opendir(buffer<i8> path);
extern buffer<i8> readdir(*void directory);
extern i32 closedir(*void directory);
func directoryFilesAt(folder string) Result<[]string> {
    if (isWindows()) {
        found := os.WindowsReadDir(folder);
        if (found.hasError()) return Result<[]string>.error("Cannot list files. You can still type a path.");
        names := []string{};
        for (_, entry := range found.unwrap()) if (!entry.Directory) names.append(entry.Name);
        return Result<[]string>.value(sortFileNames(names));
    }
    path := (folder+"\0") -> []i8;
    directory := extern.opendir(path.data);
    if ((directory -> int) == 0) return Result<[]string>.error("Cannot list files. You can still type a path.");
    // Offsets of d_type and d_name in the struct returned by libc readdir.
    typeOffset := 18; nameOffset := 19; // Linux
    if (os.OS() == "macos") {
        if (os.Arch() == "x86_64") {
            // Intel macOS uses the legacy layout for the unsuffixed readdir symbol.
            typeOffset = 6; nameOffset = 8;
        } else {
            typeOffset = 20; nameOffset = 21;
        }
    }
    names := []string{};
    for (;;) {
        entry := extern.readdir(directory);
        if ((entry -> int) == 0) break;
        kind := entry[typeOffset];
        if (kind != 8 && kind != 10 && kind != 0) continue; // Regular files and symlinks.
        bytes := []i8{};
        for (i := nameOffset; entry[i] != 0; i++) bytes.append(entry[i]);
        names.append(bytes -> string);
    }
    extern.closedir(directory);
    return Result<[]string>.value(sortFileNames(names));
}
func sortFileNames(names []string) []string {
    for (i := 1; i < len(names); i++) for (j := i; j > 0 && nameBefore(names[j], names[j-1]); j--) {
        temporary := names[j]; names[j] = names[j-1]; names[j-1] = temporary;
    }
    return names;
}
func nameBefore(first string, second string) bool {
    n := len(first) < len(second) ? len(first) : len(second);
    for (i := 0; i < n; i++) if (first[i] != second[i]) return (first[i] -> u8) < (second[i] -> u8);
    return len(first) < len(second);
}
func (a *App) resumePath(path string) bool {
    result := loadGameFrom(path);
    if (result == Result<Game>.error) { a.popupError = result.(Result<Game>.error); return false; }
    a.game = result.unwrap(); a.savePath = path; a.pendingPath = "";
    a.active = true; a.menu = false; a.flagMode = false;
    a.offsetX = 0; a.offsetY = 0; a.scroll();
    a.popup = ""; a.overwrite = false;
    a.setNotice("Saved game resumed.");
    return true;
}
func (a *App) openPicker() {
    a.popup = "picker"; a.popupError = "";
    a.fileChoice = 0; a.fileOffset = 0; a.files = {};
    if (a.saveDirectory == "") { a.popupError = "Cannot locate the user save directory."; return; }
    if (!pathPresent(a.saveDirectory)) return;
    result := directoryFilesAt(a.saveDirectory);
    if (result == Result<[]string>.error) a.popupError = result.(Result<[]string>.error);
    else a.files = result.unwrap();
}
func (a *App) openFilename(mode string, destination string) {
    if (mode == "save" && (!a.active || a.game.lost || a.game.won)) { a.setNotice("No unfinished game to save."); return; }
    a.popup = mode; a.saveDestination = destination;
    path := a.overwrite && a.pendingPath != "" ? a.pendingPath : a.currentPath();
    a.filename = mode == "save" ? (path == "" ? defaultSaveName : a.saveName(path)) : "";
    a.filenameCursor = len(a.filename);
    a.popupError = ""; a.entryChoice = 0;
}
func (a *App) cancelFilename() {
    a.popup = a.popup == "load" ? "picker" : "";
    a.popupError = "";
}
func (a *App) enteredPath() string {
    if (a.filename == "") { a.popupError = "Enter a filename."; return ""; }
    path := a.filenamePath(a.filename);
    if (path == "") a.popupError = "Enter an explicit file path or use a valid filename.";
    return path;
}
func (a *App) submitFilename() bool {
    path := a.enteredPath();
    if (path == "") return false;
    if (a.popup == "load") { a.resumePath(path); return false; }
    destination := a.saveDestination;
    a.popup = ""; a.overwrite = false;
    if (a.requestSaveTo(destination, path)) return true;
    if (!a.overwrite && !(len(a.notice) >= 9 && a.notice[:9] == "Saved to ")) {
        a.popup = "save"; a.popupError = a.notice;
    }
    return false;
}
func (a *App) beginDelete(path string) {
    if (path == "") return;
    if (!pathPresent(path) || directoryExists(path)) { a.popupError = "Choose an existing file to delete."; return; }
    a.deletePath = path; a.deleteFrom = a.popup; a.deleteSelected = false;
    a.popup = "delete"; a.popupError = "";
}
func (a *App) finishDelete(confirmed bool) {
    path := a.deletePath;
    a.popup = a.deleteFrom; a.deleteFrom = ""; a.deletePath = "";
    if (!confirmed) return;
    if (!removeFile(path)) { a.popupError = "Could not delete the file."; return; }
    if (normalizePath(a.savePath) == normalizePath(path)) a.savePath = "";
    if (normalizePath(a.pendingPath) == normalizePath(path)) { a.pendingPath = ""; a.overwrite = false; }
    if (a.popup == "picker") {
        choice := a.fileChoice;
        a.openPicker();
        a.fileChoice = choice < len(a.files)+1 ? choice : len(a.files)+1;
        a.pickerScroll();
        if (a.popupError != "") return;
    }
    a.popupError = "File deleted.";
}
func (a *App) pickerRows() int { return a.dialogHeight()-6; }
func (a *App) pickerScroll() {
    if (a.fileChoice < a.fileOffset) a.fileOffset = a.fileChoice;
    if (a.fileChoice >= a.fileOffset+a.pickerRows()) a.fileOffset = a.fileChoice-a.pickerRows()+1;
}
func (a *App) pickerSelect() {
    if (a.fileChoice == 0) a.openFilename("load", "");
    else if (a.fileChoice == len(a.files)+1) a.popup = "";
    else a.resumePath(namedSavePath(a.saveDirectory, a.files[a.fileChoice-1]));
}
func (a *App) pickerDelete() {
    if (a.fileChoice > 0 && a.fileChoice <= len(a.files)) a.beginDelete(namedSavePath(a.saveDirectory, a.files[a.fileChoice-1]));
}
func (a *App) popupKey(e tui.KeyMsg) bool {
    if (a.popup == "themes") { a.themeKey(e); return false; }
    if (e.Alt) return false;
    if (a.popup == "delete") {
        if (e.Key == "esc") a.finishDelete(false);
        else if (e.Key == "enter" || e.Key == "space") a.finishDelete(a.deleteSelected);
        else if (e.Key == "tab" || e.Key == "shift+tab" || e.Key == "left" || e.Key == "right") a.deleteSelected = !a.deleteSelected;
        return false;
    }
    if (a.popup == "picker") {
        if (e.Key == "esc") a.popup = "";
        else if (e.Key == "up" || e.Text == "k") a.fileChoice = (a.fileChoice+len(a.files)+1)%(len(a.files)+2);
        else if (e.Key == "down" || e.Key == "tab" || e.Text == "j") a.fileChoice = (a.fileChoice+1)%(len(a.files)+2);
        else if (e.Key == "pgdown") { a.fileChoice += a.pickerRows(); if (a.fileChoice > len(a.files)+1) a.fileChoice = len(a.files)+1; }
        else if (e.Key == "pgup") { a.fileChoice -= a.pickerRows(); if (a.fileChoice < 0) a.fileChoice = 0; }
        else if (e.Key == "home") a.fileChoice = 0;
        else if (e.Key == "end") a.fileChoice = len(a.files)+1;
        else if (e.Key == "delete") { a.pickerDelete(); return false; }
        else if (e.Key == "enter" || e.Key == "space") a.pickerSelect();
        a.pickerScroll(); return false;
    }
    if (e.Key == "esc") { a.cancelFilename(); return false; }
    if (e.Key == "tab") { a.entryChoice = (a.entryChoice+1)%4; return false; }
    if (e.Key == "shift+tab") { a.entryChoice = (a.entryChoice+3)%4; return false; }
    if (e.Key == "enter" || (e.Key == "space" && a.entryChoice != 0)) {
        if (a.entryChoice == 2) { a.cancelFilename(); return false; }
        if (a.entryChoice == 3) { a.beginDelete(a.enteredPath()); return false; }
        return a.submitFilename();
    }
    if (a.entryChoice != 0) return false;
    if (editEntry(&a.filename,&a.filenameCursor,e,4096)) a.popupError = "";
    return false;
}
func (a *App) popupMouse(e tui.MouseMsg) bool {
    if (a.popup == "themes") { a.themeMouse(e); return false; }
    if (a.popup == "picker" && e.Action == "scroll") {
        if (e.Button == "up" && a.fileChoice > 0) a.fileChoice--;
        if (e.Button == "down" && a.fileChoice < len(a.files)+1) a.fileChoice++;
        a.pickerScroll(); return false;
    }
    if (e.Action != "press" || e.Button != "left") return false;
    x := e.X-a.dialogLeft(); row := e.Y-a.dialogTop();
    if (x <= 0 || x >= a.dialogWidth()-1) return false;
    if (a.popup == "delete") {
        if (row == 7 && x >= 2 && x < 13) a.finishDelete(true);
        if (row == 7 && x >= 14 && x < 25) a.finishDelete(false);
    } else if (a.popup == "picker") {
        index := row-4+a.fileOffset;
        if (row >= 4 && row < 4+a.pickerRows() && index < len(a.files)+2) {
            a.fileChoice = index;
            if (index > 0 && index <= len(a.files) && a.dialogWidth() >= 20 && x >= a.dialogWidth()-1-len(pickerDeleteLabel)) a.pickerDelete();
            else a.pickerSelect();
        }
    } else {
        if (row == 4) {
            a.entryChoice = 0;
            a.filenameCursor = entryClick(a.filename,a.filenameCursor,a.dialogWidth()-7,x-3);
        }
        if (row == 7 && x >= 2 && x < 12) return a.submitFilename();
        if (row == 7 && x >= 13 && x < 25) a.cancelFilename();
        if (row == 7 && x >= 25 && x < 37) a.beginDelete(a.enteredPath());
    }
    return false;
}
